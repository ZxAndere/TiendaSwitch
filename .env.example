# ===== Variables de Entorno - ZonaSwitchChile =====
# Configura estas variables en el Panel de Railway (Variables) para Producción

# ===== REQUERIDAS EN PRODUCCIÓN =====
# Secreto para firmar tokens JWT (OBLIGATORIO en producción, genera uno seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# MongoDB Atlas URI para persistencia de datos
MONGODB_URI=

# ===== PASARELAS DE PAGO =====
# Flow Chile (Webpay / Transferencia)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://www.flow.cl/api
FLOW_DEFAULT_EMAIL=zx.andereacc@gmail.com

# Mercado Pago Chile
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ===== SERVICIOS DE EMAIL =====
# Resend (opción 1)
RESEND_API_KEY=

# Brevo (opción 2)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=

# Gmail SMTP (opción 3)
# GMAIL_USER=
# GMAIL_PASS=

# ===== SERVICIOS OPCIONALES =====
# FreeCurrencyAPI para tasas de cambio en tiempo real
FREECURRENCY_API_KEY=
